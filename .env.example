# Backend base URL used by REST client and SignalR.
PUBLIC_API_URL=http://localhost:5202

# Legal notice and privacy policy fields
PUBLIC_LEGAL_NAME=Your organization name
PUBLIC_LEGAL_STREET=Street and house number
PUBLIC_LEGAL_CITY=Postal code and city
PUBLIC_LEGAL_COUNTRY=Country
PUBLIC_LEGAL_EMAIL=contact@example.com
PUBLIC_LEGAL_RESPONSIBLE_PERSON=Responsible person full name
PUBLIC_LEGAL_RESPONSIBLE_ADDRESS=Street and house number, postal code city
PUBLIC_LEGAL_SUPERVISING_INSTITUTION=Optional supervising institution
PUBLIC_LEGAL_SUPERVISING_REPRESENTATIVE=Optional representative

# Deployment variables
DOMAIN=mydomain.com
CORS_ORIGINS=AllowedOrigins-CommaSeperated
