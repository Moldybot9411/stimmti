# Frontend
# Public Vite variables must start with VITE_.

# Backend base URL used by REST client and SignalR.
VITE_API_URL=http://localhost:5202

# Legal notice and privacy policy fields
VITE_LEGAL_NAME=Your organization name
VITE_LEGAL_STREET=Street and house number
VITE_LEGAL_CITY=Postal code and city
VITE_LEGAL_COUNTRY=Country
VITE_LEGAL_EMAIL=contact@example.com
VITE_LEGAL_RESPONSIBLE_PERSON=Responsible person full name
VITE_LEGAL_RESPONSIBLE_ADDRESS=Street and house number, postal code city
VITE_LEGAL_SUPERVISING_INSTITUTION=Optional supervising institution
VITE_LEGAL_SUPERVISING_REPRESENTATIVE=Optional representative
