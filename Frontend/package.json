{
	"name": "frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"swagger": "npx swagger-typescript-api generate -p http://localhost:5202/swagger/v1/swagger.json -o ./src/lib -n api.ts --axios",
		"sync:websocket": "cd ../Backend && dotnet tool run dotnet-tsrts --project ./Backend.csproj --output ../Frontend/src/lib/wsClient/ --enum Name",
		"sync:types": "npm run swagger && npm run sync:websocket"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.2.2",
		"@types/qrcode": "^1.5.6",
		"@types/signalr": "^2.4.3",
		"daisyui": "^5.5.20",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"swagger-typescript-api": "^13.10.0",
		"tailwindcss": "^4.2.2",
		"typescript": "^6.0.2",
		"vite": "^8.0.7"
	},
	"dependencies": {
		"@lucide/svelte": "^1.3.0",
		"@microsoft/signalr": "^10.0.0",
		"@types/d3": "^7.4.3",
		"axios": "^1.16.1",
		"d3": "^7.9.0",
		"qrcode": "^1.5.4"
	}
}
